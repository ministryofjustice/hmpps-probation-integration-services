context-cp: EMDI Context {
  entities: Entities {
    grid-columns: 3
    session: Session
    region: Region
    provider: Provider
    pdu: PDU
    lau: LAU
  }
}

context-delius: Delius Context {
  interface: EMDI\n and Delius {
    type: Anti-Corruption\nLayer
  }

  entities: Entities {
    grid-columns: 3
    upw-appointment: UPW Appointment
    upw-project: UPW Project
    contact: Contact
    enforcement: Enforcement
    event: Event
    requirement: Requirement
    provider: Provider
    team: Team
    staff: Staff
    address: Address
  }
}

context-cp -- context-delius.interface: Upstream\n\n\nDownstream
